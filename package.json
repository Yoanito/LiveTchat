{
  "name": "livetchat",
  "version": "0.1.0",
  "description": "Affiche des images et vidéos en overlay sur l'écran de ses amis.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "build": "esbuild src/net/peer.js --bundle --format=iife --platform=browser --target=chrome130 --outfile=src/net/peer.bundle.js",
    "prestart": "npm run build",
    "start": "electron .",
    "predist": "npm run build",
    "dist": "electron-builder --win portable",
    "lint": "eslint .",
    "test": "node --test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "electron": "^44.10.1",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "trystero": "^0.26.0"
  },
  "build": {
    "appId": "fr.livetchat.app",
    "productName": "LiveTchat",
    "files": [
      "src/**/*",
      "!src/net/peer.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  }
}
